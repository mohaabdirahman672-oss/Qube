# Supabase — copy from Supabase Dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Sign-In — from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com

# Sentry — from Sentry > Project Settings > Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

# RevenueCat — from RevenueCat Dashboard > Project Settings > API Keys > Apple App
# Store (public key, safe client-side by RevenueCat's own design). See
# docs/plans/freemium-paywall-v2.md.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_public_ios_key

# Note: the OpenAI key, Supabase service role key, and REVENUECAT_WEBHOOK_SECRET are
# NOT set here — they live server-side only, as Supabase project secrets
# (supabase/functions/solve, revenuecat-webhook). Never read by the client app.
