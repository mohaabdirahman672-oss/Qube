{
  "expo": {
    "name": "Qube",
    "slug": "qube",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "qube",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#06091A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qube.mathapp",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Qube uses your camera to photograph math problems and solve them instantly.",
        "NSPhotoLibraryUsageDescription": "Qube reads photos from your library so you can upload math problems to solve."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#06091A"
      },
      "package": "com.qube.mathapp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.59533189278-4qcpoo5k78h6vjo20le13uo481rfud8b"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Qube reads photos from your library so you can upload math problems to solve.",
          "cameraPermission": "Qube uses your camera to photograph math problems and solve them instantly."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.0"
          },
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "expo-font",
      "expo-asset",
      "@sentry/react-native/expo"
    ],
    "extra": {
      "eas": {
        "projectId": "e45a9693-f636-4a31-b786-93d86db2ee86"
      }
    }
  }
}
